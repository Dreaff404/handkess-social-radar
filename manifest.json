{
  "manifest_version": 3,
  "name": "HandKess Social Radar",
  "version": "2.1.0",
  "description": "Wettbewerber-Analyse direkt auf YouTube, Instagram, TikTok und Facebook: Beiträge nach den besten und schlechtesten sortieren, Kennzahlen einblenden, Formate taggen.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "radar-hintergrund.js"
  },
  "action": {
    "default_title": "HandKess Social Radar – Vergleich",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "radar-einstellungen.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "kern.js",
        "youtube.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram-mitlesen.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "kern.js",
        "sammler.js",
        "instagram.js",
        "panel.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "tiktok-mitlesen.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "kern.js",
        "sammler.js",
        "tiktok.js",
        "panel.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "facebook-mitlesen.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "kern.js",
        "sammler.js",
        "facebook.js",
        "panel.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
